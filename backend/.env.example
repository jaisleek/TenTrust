# Mono Configuration
# Get your keys at https://app.withmono.com
MONO_SECRET_KEY=
MONO_BASE_URL=https://api.withmono.com
MONO_WEBHOOK_SECRET=

# Prembly Configuration
# Get your keys at https://dashboard.prembly.com
PREMBLY_SECRET_KEY=
PREMBLY_APP_ID=
PREMBLY_BASE_URL=https://api-sandbox.prembly.com
PREMBLY_WEBHOOK_SECRET=

# Supabase (service role key is backend-only; never expose it to Vite)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Payment provider: use "flutterwave" or "paystack". Flutterwave is the planned launch provider.
PAYMENT_PROVIDER=flutterwave
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=

# Paystack is an optional alternative (test keys in staging, live keys only in production)
PAYSTACK_SECRET_KEY=
PAYMENT_CALLBACK_URL=http://localhost:3000/dashboard?tab=verify-tenant
PUBLIC_APP_URL=http://localhost:3000
SCREENING_CONSENT_VERSION=2026-10-02
SCREENING_PRICES_CONFIRMED=false

# Enable only after the corresponding live provider configuration has been verified
PREMBLY_CHECKS_ENABLED=false
MONO_CREDIT_CHECKS_ENABLED=false

# App Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
